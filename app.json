{
  "expo": {
    "name": "Paal-Note",
    "slug": "paal-note",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#059669"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paalnote.dairy"
    },
    "android": {
      "package": "com.paalnote.dairy",
      "adaptiveIcon": {
        "backgroundColor": "#059669"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    }
  }
}
